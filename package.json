{
  "name": "kitamo-admin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "security:check": "node scripts/check-client-secrets.mjs",
    "security:bundle": "node scripts/check-production-bundle.mjs",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run security:check && npm run build && npm run security:bundle",
    "verify": "npm run quality && npm run test:e2e"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "type": "module"
}
